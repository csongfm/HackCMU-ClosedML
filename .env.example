# MongoDB Atlas connection string and database name
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=briefly

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Gemini creates grounded story summaries and briefing transcripts.
# Create a key in Google AI Studio and keep it server-side.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
# Optional. Search grounding needs available Google Search quota/billing.
GEMINI_USE_GOOGLE_SEARCH=true

# Kept server-side; never prefix these with NEXT_PUBLIC_
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=replace-with-your-elevenlabs-voice-id
